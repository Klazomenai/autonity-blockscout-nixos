# Per-host hardware probe — generated by `nixos-anywhere
# --generate-hardware-config` on first install. Specific to the
# OVH instance currently being deployed; regenerated each cycle.
hardware-configuration.nix

# Local staging directory for `--extra-files`. The Makefile builds
# this from ~/.config/pharos-secrets/ (secret_key_base,
# database_password, root_authorized_keys); do not commit.
# Note: pharos-runtime.nix is NOT staged here — it's an
# operator-local Nix-eval-time overlay, see below.
.staging/

# Last-provisioned instance ID, written by `make provision` so
# subsequent recipes (`make halt`) can target it without operator
# bookkeeping.
.last-instance-id

# Cruise orchestrator log — written by `make cruise` so it can parse
# the IP back out of provision's output for downstream submakes.
.cruise.log

# Spec captures from `make capture-specs` (when implemented).
# Operators distil rows into the README's Discovered Specs section
# by hand; raw captures stay local.
captures/

# Locally-rendered pharos-runtime.nix (generated by Makefile from
# ~/.config/pharos-secrets/{server_name,acme_email}; imported by
# the flake's `nixosConfigurations.ovh-test` at Nix-eval time on
# the operator's machine — NOT shipped to the target host). Should
# never be committed — operator-specific DNS hostname + email leak.
pharos-runtime.nix

# Nix build outputs.
result
result-*
